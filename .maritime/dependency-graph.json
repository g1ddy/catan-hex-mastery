{
  "modules": [],
  "summary": {
    "error": 0,
    "ignore": 0,
    "info": 0,
    "totalCruised": 0,
    "totalDependenciesCruised": 0,
    "violations": [],
    "warn": 0,
    "optionsUsed": {
      "baseDir": "/app",
      "combinedDependencies": false,
      "detectJSDocImports": false,
      "detectProcessBuiltinModuleCalls": false,
      "doNotFollow": {
        "path": "node_modules"
      },
      "enhancedResolveOptions": {
        "exportsFields": [
          "exports"
        ],
        "conditionNames": [
          "import",
          "require",
          "node",
          "default"
        ]
      },
      "exoticRequireStrings": [],
      "externalModuleResolutionStrategy": "node_modules",
      "metrics": false,
      "moduleSystems": [
        "cjs",
        "es6"
      ],
      "preserveSymlinks": false,
      "reporterOptions": {
        "dot": {
          "collapsePattern": "node_modules/[^/]+"
        }
      },
      "skipAnalysisNotInRules": false,
      "tsConfig": {
        "fileName": "tsconfig.app.json"
      },
      "tsPreCompilationDeps": true,
      "args": "src"
    },
    "ruleSetUsed": {
      "forbidden": [
        {
          "name": "core-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/core"
          },
          "to": {
            "path": "^src/game/geometry|^src/game/mechanics|^src/game/generation|^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots|^src/shared|^src/features"
          },
          "comment": "Core layer (Types/Constants) must be pure.",
          "scope": "module"
        },
        {
          "name": "geometry-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/geometry"
          },
          "to": {
            "path": "^src/game/mechanics|^src/game/generation|^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots|^src/shared|^src/features"
          },
          "comment": "Geometry layer must be pure math (only depend on Core).",
          "scope": "module"
        },
        {
          "name": "mechanics-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/mechanics"
          },
          "to": {
            "path": "^src/game/generation|^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots|^src/shared|^src/features"
          },
          "comment": "Mechanics layer must be pure and not depend on higher layers.",
          "scope": "module"
        },
        {
          "name": "generation-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/generation"
          },
          "to": {
            "path": "^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots"
          },
          "comment": "Generation layer cannot depend on Rules, Analysis, Moves, or Bots.",
          "scope": "module"
        },
        {
          "name": "rules-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/rules"
          },
          "to": {
            "path": "^src/game/analysis|^src/game/moves|^src/bots"
          },
          "comment": "Rules layer (Validator/Enumerator) cannot depend on Analysis, Moves, or Bots.",
          "scope": "module"
        },
        {
          "name": "evaluation-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/analysis"
          },
          "to": {
            "path": "^src/game/moves|^src/bots"
          },
          "comment": "Evaluation layer (Coach) evaluates state, not moves or bots.",
          "scope": "module"
        },
        {
          "name": "moves-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/moves"
          },
          "to": {
            "path": "^src/bots"
          },
          "comment": "Moves are executed by game engine, should not depend on Bots.",
          "scope": "module"
        },
        {
          "name": "bypass-rule-facade",
          "severity": "error",
          "from": {
            "path": "^src/game/moves"
          },
          "to": {
            "path": "^src/game/rules",
            "pathNot": "^src/game/rules/validator.ts|^src/game/rules/queries.ts"
          },
          "comment": "Moves must access rules via the RuleEngine facade (validator.ts) or Query facade (queries.ts).",
          "scope": "module"
        },
        {
          "name": "logic-ui-violation",
          "severity": "error",
          "from": {
            "path": "^src/game/core|^src/game/geometry|^src/game/mechanics|^src/game/generation|^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots"
          },
          "to": {
            "path": "^src/shared|^src/features"
          },
          "comment": "Game logic (Core, Rules, Moves) cannot depend on UI (Features, Shared).",
          "scope": "module"
        },
        {
          "name": "shared-layer-violation",
          "severity": "error",
          "from": {
            "path": "^src/shared"
          },
          "to": {
            "path": "^src/features|^src/game/geometry|^src/game/mechanics|^src/game/generation|^src/game/rules|^src/game/analysis|^src/game/moves|^src/bots"
          },
          "comment": "Shared UI cannot depend on Features or Game Logic (except Core Types/Config).",
          "scope": "module"
        },
        {
          "name": "feature-isolation",
          "severity": "info",
          "from": {
            "path": "^src/features",
            "pathNot": "^src/features/game"
          },
          "to": {
            "path": "^src/features",
            "pathNot": "^src/features/[^/]+"
          },
          "comment": "Features should be independent. Cross-feature imports are discouraged.",
          "scope": "module"
        }
      ]
    }
  }
}