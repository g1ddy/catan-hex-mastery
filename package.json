{
  "name": "hex-mastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "depcruise src --config config/dependency-cruiser.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest --config config/jest.config.cjs",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:debug": "playwright test --config config/playwright.debug.config.ts",
    "test:screenshots": "playwright test -c config/playwright.screenshots.config.ts",
    "check:arch": "depcruise src --config config/dependency-cruiser.cjs",
    "generate:graph": "npx --yes --package=@dependency-maritime/cli@0.1.0-beta.7 maritime graph --input .maritime --output docs/images/dependency-graph.svg --graph-profile compact-architecture",
    "analyze:maritime": "maritime analyze --source src --output .maritime --depcruise-config config/dependency-cruiser.maritime.cjs --fail-on-unmeasured",
    "verify:maritime": "node scripts/validate-maritime-artifacts.cjs"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hexgrid": "^2.0.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "react-tooltip": "^5.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.26",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^8.1.4"
  }
}
